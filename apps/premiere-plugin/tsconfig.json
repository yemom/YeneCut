{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "@adobe/cc-ext-uxp-types",
      "@types/node",
      "@adobe/premierepro",
      "@types/react",
      "@types/react-dom",
      "vitest/globals"
    ],
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "scripts", "dist", "assets"]
}
