{
  "name": "yenecut-premiere-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build",
    "dev": "concurrently -k -n vite,types \"vite build --watch\" \"tsc --watch --noEmit --preserveWatchOutput\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@adobe/cc-ext-uxp-types": "^7.3.1",
    "@adobe/premierepro": "^27.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "jsdom": "^24.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^2.1.4"
  }
}
