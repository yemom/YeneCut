{
  "id": "com.yenecut.ai",
  "name": "YeneCut AI",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "http://127.0.0.1",
        "http://localhost",
        "https://localhost"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "yenecutPanel",
      "type": "panel",
      "minimumSize": { "width": 420, "height": 520 },
      "maximumSize": { "width": 2400, "height": 2400 },
      "preferredDockedSize": { "width": 420, "height": 640 },
      "preferredFloatingSize": { "width": 480, "height": 720 },
      "label": { "default": "YeneCut AI" }
    }
  ],
  "icons": []
}
